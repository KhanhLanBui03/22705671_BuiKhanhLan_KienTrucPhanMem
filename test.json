              "mode": "raw",
              "raw": "{\"name\":\"iPhone 15\",\"description\":\"Latest iPhone\",\"price\":999.99,\"stock\":50}"
            },
            "url": "http://localhost:8081/api/products"
          }
        },
        {
          "name": "PUT Update Product (Bulkhead)",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"iPhone 15 Pro\",\"price\":1199.99,\"stock\":30}"
            },
            "url": "http://localhost:8081/api/products/1"
          }
        }
      ]
    },
